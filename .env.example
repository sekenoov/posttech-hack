# Copy to .env and adjust. Never commit .env.

# Ports published on the host
FRONTEND_PORT=3000
BACKEND_PORT=8000

# JWT signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a key is generated once and stored in the data volume (data/.secret_key),
# so restarts keep sessions. Set it explicitly to share one key across instances.
SECRET_KEY=

# AI Jana LLM layer: openrouter | anthropic | none
# Without a key AI Jana runs in retrieval-only mode (fully offline).
LLM_PROVIDER=openrouter
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
